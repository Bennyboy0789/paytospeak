# Copy to .env.local for local dev. Production values live in the Vercel dashboard.
# Never commit .env.local.

# Canonical origin, no trailing slash. Used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://paidtospeak.biz

# GA4 measurement ID (G-XXXXXXXXXX). Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_ID=

# MailChimp — newsletter + book-notify forms. TODO(kc): list ID and single vs double opt-in.
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# "false" for single opt-in. Default (unset) is double opt-in: MailChimp emails a confirmation link.
MAILCHIMP_DOUBLE_OPT_IN=
